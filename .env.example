# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Find in Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ENDPOINT_URL=https://<account_id>.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Iceberg catalog (Cloudflare R2 Data Catalog) ──────────────────────────────
# Enable in Cloudflare dashboard → R2 → your bucket → Settings → Data Catalog
# Then copy the catalog endpoint URL shown there
CATALOG_URI=https://catalog.cloudflarestorage.com/<account_id>/<bucket_name>
# Create an API token at Cloudflare dashboard → My Profile → API Tokens
# Needs "Workers R2 Storage: Edit" permission
CATALOG_TOKEN=

# ── Scraping behaviour ────────────────────────────────────────────────────────
# Max events to scrape per group (0 = unlimited)
MAX_EVENTS_PER_GROUP=50
# Seconds to wait between Meetup requests (be polite)
REQUEST_DELAY_SECONDS=1.5
