# ── Postgres (Aiven) ──────────────────────────────────────────────────────────
# Service URI from the Aiven console, e.g.:
# postgres://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require
# Named DATABASE_URL (not POSTGRES_URI) to match what Aiven's "Connect service"
# app integration always injects.
DATABASE_URL=

# ── Scraping behaviour ────────────────────────────────────────────────────────
# Max events to scrape per group (0 = unlimited)
MAX_EVENTS_PER_GROUP=50
# Seconds to wait between Meetup requests (be polite)
REQUEST_DELAY_SECONDS=1.5
