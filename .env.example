# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Find in Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ENDPOINT_URL=https://<account_id>.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Lakekeeper catalog ────────────────────────────────────────────────────────
# Local dev: leave LAKEKEEPER_PG_URL unset to use the bundled catalog-db container
# Aiven Apps: set to your Aiven Postgres service URI (includes ?sslmode=require)
LAKEKEEPER_CATALOG_URI=http://localhost:8181/catalog
LAKEKEEPER_PG_URL=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LAKEKEEPER_ENCRYPTION_KEY=
# Aiven Apps only: the public URL of the lakekeeper service (for internal link generation)
LAKEKEEPER_BASE_URI=

# ── Scraping behaviour ────────────────────────────────────────────────────────
# Max events to scrape per group (0 = unlimited)
MAX_EVENTS_PER_GROUP=50
# Seconds to wait between Meetup requests (be polite)
REQUEST_DELAY_SECONDS=1.5
